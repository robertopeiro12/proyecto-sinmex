# Copia este archivo como .env.development (o .env.production) y llena los valores reales.
# Nunca subas .env.* con valores reales a git — solo este archivo de ejemplo se sube.

# Project Settings > API en el dashboard de Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > Database en el dashboard de Supabase (connection string, con el password real)
# El backend ya la usa para conectarse a Postgres vía Kysely (ver apps/backend/src/database).
DATABASE_URL=

# Autenticacion (T-06). Genera el secreto con: openssl rand -base64 32
# El backend valida estas variables al arrancar y no arranca si alguna esta mal
# (ver apps/backend/src/configuracion.schema.ts). Ojo: dejarlas en BLANCO no es
# lo mismo que borrarlas — una linea vacia tambien falla, a proposito.
JWT_SECRET=
# Formato <numero><s|m|h|d>, p.ej. 15m. "15min" no es valido.
ACCESS_TOKEN_TTL=15m
# Entero positivo, en horas.
REFRESH_TOKEN_TTL_HORAS=12

# Cookies de sesion. En produccion portal y API deben compartir dominio padre:
# COOKIE_DOMAIN=.ejemplo.mx, COOKIE_SECURE=true
# Ver "Requisito de despliegue" en el README — no es opcional.
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Solo lax o strict. 'none' esta prohibido: apagaria la unica defensa contra
# CSRF que hay hoy. Si el portal y la API quedan en dominios distintos, la
# solucion es el dominio, no esta variable.
COOKIE_SAMESITE=lax

# Origen del portal, para CORS con credenciales
PORTAL_URL=http://localhost:3001

# --- App de tablet (T-06, sesion del vendedor) ---
# Todo en HORAS, igual que REFRESH_TOKEN_TTL_HORAS. El porque de cada default
# esta en apps/backend/src/modules/auth/ttl-sesion.ts.
#
# Vida del JWT de acceso de la app: 12 h = una jornada. NO es lo que mantiene
# viva la sesion offline (sin red nadie puede verificar un JWT); es lo que
# permite llamar a la API en cualquier momento del dia sin refrescar.
ACCESS_TOKEN_TTL_APP_HORAS=12
# Vida de la sesion de refresh de la app: 7 dias.
REFRESH_TOKEN_TTL_APP_HORAS=168
# Horas que la tablet puede operar SIN hablar con el servidor. Es el limite que
# acota el dano de una tablet perdida. No puede superar el valor de arriba (el
# backend no arranca si lo hace). Ver ADR-0005 en el vault.
VENTANA_OFFLINE_MAX_HORAS=72
# Coste del PBKDF2 con el que la app deriva su verificador local. Se manda
# desde aqui para poder ajustarlo cuando se mida en una tablet real, sin
# publicar una version nueva de la app. Minimo 10000.
VERIFICADOR_LOCAL_ITERACIONES=60000
